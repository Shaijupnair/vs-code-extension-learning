            { "status": "High-Critical", "min": 20.0, "max": 150 }
          ]
        },
        {
          "test_name": "Free T4",
          "loinc": "2278-4",
          "unit": "ng/dL",
          "interpretation_rules": [
            { "status": "Low-Critical", "min": 0, "max": 0.39 },
            { "status": "Low", "min": 0.4, "max": 0.79 },
            { "status": "Normal", "min": 0.8, "max": 1.8 },
            { "status": "High", "min": 1.81, "max": 4.99 },
            { "status": "High-Critical", "min": 5.0, "max": 15.0 }
          ]
        }
      ]
    },
    {
      "panel_id": "IMM-005",
      "panel_name": "Immunology",
      "tests": [
        {
          "test_name": "C-Reactive Protein (CRP)",
          "loinc": "1988-5",
          "unit": "mg/L",
          "interpretation_rules": [
            { "status": "Normal (Low inflammation)", "min": 0, "max": 3.0 },
            { "status": "High (Moderate inflammation)", "min": 3.1, "max": 10.0 },
            { "status": "High-Critical (Acute infection)", "min": 10.1, "max": 500 }
          ]
        }
      ]
    },
    {
      "panel_id": "ONC-006",
      "panel_name": "Tumor Markers",
      "tests": [
        {
          "test_name": "PSA",
          "loinc": "2857-1",
          "unit": "ng/mL",
          "interpretation_rules": [
            { "status": "Normal", "min": 0, "max": 4.0 },
            { "status": "High (Requires Follow-up)", "min": 4.1, "max": 10.0 },
            { "status": "High-Critical", "min": 10.1, "max": 1000 }
          ]
        }
      ]
    },
    {
      "panel_id": "NUT-007",
      "panel_name": "Nutrition & Vitamins",
      "tests": [
        {
          "test_name": "Vitamin D, 25-Hydroxy",
          "loinc": "62292-8",
          "unit": "ng/mL",
          "interpretation_rules": [
            { "status": "Severe Deficiency", "min": 0, "max": 10 },
            { "status": "Deficient", "min": 11, "max": 29 },
            { "status": "Sufficient", "min": 30, "max": 100 },
            { "status": "Potential Toxicity", "min": 101, "max": 250 }
          ]
        },
        {
          "test_name": "Vitamin B12",
          "loinc": "2132-9",
          "unit": "pg/mL",
          "interpretation_rules": [
            { "status": "Low-Critical", "min": 0, "max": 150 },
            { "status": "Low", "min": 151, "max": 199 },
            { "status": "Normal", "min": 200, "max": 900 },
            { "status": "High", "min": 901, "max": 2000 }
          ]
        }
      ]
    },
    {
      "panel_id": "COA-008",
      "panel_name": "Coagulation Panel",
      "tests": [
        {
          "test_name": "Prothrombin Time (PT)",
          "loinc": "5902-2",
          "unit": "sec",
          "interpretation_rules": [
            { "status": "Normal", "min": 11.0, "max": 13.5 },
            { "status": "High", "min": 13.6, "max": 29.9 },
            { "status": "High-Critical", "min": 30.0, "max": 120.0 }
          ]
        },
        {
          "test_name": "INR",
          "loinc": "4544-3",
          "unit": "ratio",
          "interpretation_rules": [
            { "status": "Normal", "min": 0.8, "max": 1.1 },
            { "status": "Therapeutic Range", "min": 2.0, "max": 3.0 },
            { "status": "High", "min": 3.1, "max": 4.9 },
            { "status": "High-Critical (Bleeding Risk)", "min": 5.0, "max": 15.0 }
          ]
        }
      ]
    }
  ]
}